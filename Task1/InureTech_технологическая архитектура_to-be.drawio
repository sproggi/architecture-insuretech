                    <mxGeometry x="2320" y="997" width="300" height="42" as="geometry"/>
                </mxCell>
                <mxCell id="c97" value="&lt;b&gt;PostgreSQL + Patroni + etcd&lt;/b&gt; — standby-кластер" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7ff;strokeColor=#2f6bff;strokeWidth=2;align=left;verticalAlign=top;fontSize=15;fontStyle=1;fontColor=#1a3a6b;spacingLeft=52;spacingTop=8;" parent="1" vertex="1">
                    <mxGeometry x="1460" y="1160" width="1260" height="400" as="geometry"/>
                </mxCell>
                <mxCell id="c99" value="&lt;b&gt;Standby leader&lt;/b&gt;&lt;br&gt;async replica региона 1&lt;br&gt;read-only · promote" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff4e5;strokeColor=#7a9bd6;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=6;fontSize=12;fontColor=#14264a;" parent="1" vertex="1">
                    <mxGeometry x="1490" y="1230" width="380" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="c101" value="&lt;b&gt;Replica 2b&lt;/b&gt;&lt;br&gt;read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7faff;strokeColor=#7a9bd6;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=6;fontSize=12;fontColor=#14264a;" parent="1" vertex="1">
                    <mxGeometry x="1900" y="1230" width="380" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="c103" value="&lt;b&gt;Replica 2c&lt;/b&gt;&lt;br&gt;read-only" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f7faff;strokeColor=#7a9bd6;align=left;verticalAlign=middle;spacingLeft=54;spacingRight=6;fontSize=12;fontColor=#14264a;" parent="1" vertex="1">
                    <mxGeometry x="2310" y="1230" width="380" height="210" as="geometry"/>
                </mxCell>
                <mxCell id="c105" value="&lt;b&gt;Patroni health check:&lt;/b&gt;&lt;br&gt;/primary · /replica · etcd quorum" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eaf7ef;strokeColor=#2e8b57;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontColor=#1f6b3f;" parent="1" vertex="1">
                    <mxGeometry x="1490" y="1455" width="580" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c106" value="&lt;b&gt;pgBackRest:&lt;/b&gt; непрерывный WAL + ежедневный base backup&lt;br&gt;→ Object Storage · PITR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e6;strokeColor=#b8860b;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontColor=#7a5a00;" parent="1" vertex="1">
                    <mxGeometry x="2090" y="1455" width="600" height="70" as="geometry"/>
                </mxCell>
                <mxCell id="c127" value="&lt;b&gt;Object Storage&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;резервные копии, WAL, статика&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7ff;strokeColor=#7a9bd6;align=left;verticalAlign=middle;spacingLeft=68;spacingRight=6;fontSize=14;fontColor=#14264a;" parent="1" vertex="1">
                    <mxGeometry x="980" y="1720" width="520" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c129" value="&lt;b&gt;Мониторинг и алертинг&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot;&gt;Prometheus · Alertmanager · логи&lt;br&gt;метрики со всех регионов&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f3f7ff;strokeColor=#7a9bd6;align=left;verticalAlign=middle;spacingLeft=68;spacingRight=6;fontSize=14;fontColor=#14264a;" parent="1" vertex="1">
                    <mxGeometry x="1700" y="1720" width="520" height="120" as="geometry"/>
                </mxCell>
                <mxCell id="c133" value="&lt;b&gt;Масштабирование и отказоустойчивость&lt;/b&gt;&lt;br&gt;• Stateless-сервисы масштабируются горизонтально: HPA по CPU/RPS, Cluster Autoscaler, ≥2 реплики в каждой AZ, anti-affinity и PDB.&lt;br&gt;• PostgreSQL масштабируется вертикально (primary) + read replicas. 50 ГБ не требуют шардирования.&lt;br&gt;• Держим запас ёмкости N+1: при отказе региона второй принимает 100% трафика.&lt;br&gt;• Сетевые зоны: public — ALB/WAF, private — поды, isolated — БД. Security Groups, NAT, у БД нет публичного доступа." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#3d2d00;" parent="1" vertex="1">
                    <mxGeometry x="40" y="1900" width="640" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="c134" value="&lt;b&gt;Kubernetes: независимые кластеры&lt;/b&gt;&lt;br&gt;• В каждом регионе — отдельный Managed Kubernetes, растянутый на 3 AZ; control plane HA, node pools в каждой AZ.&lt;br&gt;• Один «растянутый» кластер через WAN не используем: высокая задержка etcd, риск потери кворума и единая точка отказа.&lt;br&gt;• Независимые кластеры изолируют blast radius и позволяют обновлять регионы по очереди.&lt;br&gt;• Одинаковая конфигурация через GitOps/Helm; GeoDNS переключает трафик между кластерами." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#3d2d00;" parent="1" vertex="1">
                    <mxGeometry x="710" y="1900" width="640" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="c135" value="&lt;b&gt;Балансировка, health check, failover&lt;/b&gt;&lt;br&gt;• GeoDNS/GSLB с TTL 30 с направляет клиента в ближайший здоровый регион; приложение активно в обоих регионах.&lt;br&gt;• CDN отдаёт статику, поэтому время загрузки не зависит от географии.&lt;br&gt;• Региональный L7 ALB + WAF распределяет трафик по AZ и подам.&lt;br&gt;• Health check: GSLB → ALB (HTTPS /health, 5 с); ALB → Ingress (/readyz, 10 с); kubelet → поды (readiness/liveness); Patroni → БД (/primary, /replica); etcd quorum.&lt;br&gt;• Failover: GeoDNS убирает отказавший регион; клиенты повторяют идемпотентные запросы; Patroni повышает standby." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#3d2d00;" parent="1" vertex="1">
                    <mxGeometry x="1380" y="1900" width="640" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="c136" value="&lt;b&gt;БД, RTO/RPO, шардирование&lt;/b&gt;&lt;br&gt;• Регион 1: primary + sync replica (RPO = 0) + async replica; автоматический failover Patroni.&lt;br&gt;• Регион 2: standby-кластер с async streaming replication, RPO &amp;lt; 15 мин; promote при отказе региона 1.&lt;br&gt;• RTO: автоматический failover 1–5 мин, полное переключение &amp;lt; 45 мин.&lt;br&gt;• Бэкапы: pgBackRest — непрерывная архивация WAL + ежедневный base backup в Object Storage, PITR.&lt;br&gt;• Шардирование на 50 ГБ не применяем: вертикальное масштабирование + read replicas. При росте до нескольких ТБ — шардирование по region_id/client_id (Citus)." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;fontSize=11;fontColor=#3d2d00;" parent="1" vertex="1">
                    <mxGeometry x="2050" y="1900" width="670" height="300" as="geometry"/>
                </mxCell>
                <mxCell id="c59" value="sync replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8a4baf;strokeWidth=2;fontColor=#8a4baf;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c51" target="c53" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c60" value="async replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8a4baf;strokeWidth=2;fontColor=#8a4baf;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c53" target="c55" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c107" value="sync replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8a4baf;strokeWidth=2;fontColor=#8a4baf;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c99" target="c101" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c108" value="async replication" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#8a4baf;strokeWidth=2;fontColor=#8a4baf;fontSize=10;labelBackgroundColor=#ffffff;dashed=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" parent="1" source="c101" target="c103" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c109" value="статика" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#33475b;strokeWidth=2;fontColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c3" target="c5" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c110" value="динамика / API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#33475b;strokeWidth=2;fontColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.35;entryDx=0;entryDy=0;" parent="1" source="c3" target="c7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c111" value="API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#33475b;strokeWidth=2;fontColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c4" target="c7" edge="1">
                    <mxGeometry relative="1" as="geometry"/>
                </mxCell>
                <mxCell id="c112" value="трафик" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#33475b;strokeWidth=2;fontColor=#33475b;fontSize=11;labelBackgroundColor=#ffffff;dashed=0;exitX=0.30;exitY=1;exitDx=0;exitDy=0;entryX=0.50;entryY=0;entryDx=0;entryDy=0;" parent="1" source="c7" target="c13" edge="1">
                    <mxGeometry relative="1" as="geometry">
                        <Array as="points">
                            <mxPoint x="562" y="320"/>
                            <mxPoint x="280" y="320"/>
                        </Array>
